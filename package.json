{
  "name": "pbmp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "db:up": "docker compose up -d",
    "prebuild": "npm install --include=dev --no-audit --no-fund",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "lucide-react": "^1.39.0",
    "mysql2": "^3.24.3",
    "postcss": "^8.5.26",
    "ra-data-json-server": "^5.15.3",
    "ra-i18n-polyglot": "^5.15.3",
    "ra-language-english": "^5.15.3",
    "react": "^19.2.8",
    "react-admin": "^5.15.3",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.2.4",
    "oxlint": "^1.79.0"
  }
}
