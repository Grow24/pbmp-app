{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PBMP Desktop",
  "mainBinaryName": "pbmp-desktop",
  "version": "0.1.0",
  "identifier": "ai.grow24.pbmp",
  "build": {
    "beforeDevCommand": "npm run client",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PBMP Desktop",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PBMP Desktop",
    "longDescription": "PBMP Web workbench packaged as a desktop application with a minimal native Rust host.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
