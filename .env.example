# Local MySQL (docker-compose maps 3310, existing container often uses 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pbmp_workbench
PORT=5174

# React-admin App Manager (JSONPlaceholder). Optional; this is the default.
VITE_JSON_SERVER_URL=https://jsonplaceholder.typicode.com

# Human AI Experience — OpenAI-compatible chat (LibreChat / OpenAI / OpenRouter / Ollama)
# Leave AI_API_KEY empty to use the canvas-aware local assistant (still streams, artifacts, save).
# On Zeabur, set these on the Node service Variables tab (not in Git).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Zeabur: do NOT create MYSQL_* variables on the Node service.
# They are injected by the MySQL marketplace service. On the Node service set:
# DB_HOST=${MYSQL_HOST}
# DB_PORT=${MYSQL_PORT}
# DB_USER=${MYSQL_USERNAME}
# DB_PASSWORD=${MYSQL_PASSWORD}
# DB_NAME=${MYSQL_DATABASE}
# PORT is set automatically by Zeabur.
